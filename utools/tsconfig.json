{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"],
      "@tauri-apps/api/core": ["src/shims/core.ts"],
      "@tauri-apps/api/event": ["src/shims/event.ts"],
      "@tauri-apps/plugin-dialog": ["src/shims/dialog.ts"]
    }
  },
  "include": ["../src"]
}
